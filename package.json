{
  "name": "@kilic/html-cv-3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Cenk Kilic",
    "email": "cenk@kilic.dev",
    "url": "https://cenk.kilic.dev"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:start": "vite dev --clearScreen false --host 0.0.0.0 --port 4200",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "preview": "vite preview --clearScreen false --host 0.0.0.0 --port 4200",
    "format": "prettier --log-level warn --write src/ && pnpm run lint --fix",
    "lint": "eslint"
  },
  "simple-git-hooks": {
    "pre-commit": "[ -n \"$SKIP_GIT_HOOKS\" ] && true || pnpm exec lint-staged",
    "prepare-commit-msg": "[ -t 1 ] && exec < /dev/tty && git cz --hook || true"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx,cjs,svelte,spec.ts}": [
      "prettier --loglevel warn --write",
      "eslint --fix"
    ],
    "*.{svelte,html,css,json,md}": [
      "prettier --loglevel warn --write"
    ]
  },
  "devDependencies": {
    "@cenk1cenk2/eslint-config": "^3.3.2",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@neoconfetti/svelte": "^2.2.2",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie": "^1.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "lint-staged": "^17.4.1",
    "mdsvex": "^0.12.8",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "svelte-fa": "^4.0.4",
    "tailwindcss": "^4.3.3",
    "theme-colors": "^0.1.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "date-fns": "^4.4.0"
  }
}
